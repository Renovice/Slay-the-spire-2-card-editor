<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>card_editor</AssemblyName>
    <RootNamespace>SlayTheSpire2Mod.CardEditor</RootNamespace>
    <Version>10.0.0</Version>
    <LangVersion>latest</LangVersion>
    <OutputPath>build\</OutputPath>
    <Sts2GameDir Condition="'$(Sts2GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Slay the Spire 2\data_sts2_windows_x86_64</Sts2GameDir>
    <Sts2ReferenceDir Condition="'$(Sts2ReferenceDir)' == '' and Exists('$(Sts2GameDir)\sts2.dll')">$(Sts2GameDir)</Sts2ReferenceDir>
    <Sts2ReferenceDir Condition="'$(Sts2ReferenceDir)' == ''">$(MSBuildProjectDirectory)\build\net9.0</Sts2ReferenceDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(Sts2ReferenceDir)\sts2.dll</HintPath>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(Sts2ReferenceDir)\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(Sts2ReferenceDir)\GodotSharp.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
