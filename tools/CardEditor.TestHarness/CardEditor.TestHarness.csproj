<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CardEditor.TestHarness</AssemblyName>
    <RootNamespace>CardEditor.TestHarness</RootNamespace>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Sts2GameDir Condition="'$(Sts2GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Slay the Spire 2\data_sts2_windows_x86_64</Sts2GameDir>
    <Sts2ReferenceDir Condition="'$(Sts2ReferenceDir)' == ''">$(Sts2GameDir)</Sts2ReferenceDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\mods\card_editor\card_editor.csproj" />
    <Reference Include="sts2">
      <HintPath>$(Sts2ReferenceDir)\sts2.dll</HintPath>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(Sts2ReferenceDir)\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(Sts2ReferenceDir)\GodotSharp.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
